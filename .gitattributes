* text=auto
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.3mf binary
*.stl binary
*.npz binary
*.png binary
*.step -diff
# Preserve delivered CSV bytes (including original CRLF) across clones.
*.csv -text whitespace=cr-at-eol
# Generated vector previews are hash-pinned export artifacts.
*.svg -diff -whitespace
# Keep the upstream license verbatim, including its final blank line.
references/amoeba-LICENSE.txt whitespace=-blank-at-eof
